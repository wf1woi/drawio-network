        <mxCell id="06_5_06c5" value="&lt;b&gt;上传文档&lt;/b&gt;&lt;br&gt;Swagger / OpenAPI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
