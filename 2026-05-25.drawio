          </mxGeometry>
        </mxCell>
        <mxCell id="n32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=15;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;结果返回给应用&lt;br/&gt;同时沉淀审计记录&lt;/b&gt;" vertex="1">
