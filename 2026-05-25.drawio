        </mxCell>
        <mxCell id="e67" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#CBD5E1;strokeWidth=1;fontSize=12;fontColor=#374151;dashed=1;dashPattern=6 4;endArrow=none;startArrow=none;" value="">
