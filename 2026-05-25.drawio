        <mxCell id="e75" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontSize=12;fontColor=#374151;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;" value="5. 外部服务返回结果">
