  <diagram id="218001e274244a6993b9f68ff4f7df13" name="07 双令牌授权流程">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="07_3_5acd" value="第三方应用接入中心：短 Token 管访问，身份票据管用户信息" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#111827;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="07_4_15ac" value="用户浏览器 访问应用页面" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="07_5_f042" value="第三方应用 发起授权" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="150" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="07_6_b8c3" value="XGD 接入中心 检查登录态 / 应用状态 回调地址 / 用户权限" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="125" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="07_7_a27f" value="Token 映射存储 用户 / 应用 / scope / 过期" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF7E6;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="150" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="07_8_3164" value="1. 访问业务页面" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F5597;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="07_4_15ac" target="07_5_f042">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="07_9_a52f" value="2. 跳转授权" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F5597;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="07_5_f042" target="07_6_b8c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="07_10_9da1" value="3. 返回 code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="07_6_b8c3" target="07_5_f042">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="07_11_a852" value="4. code 换 token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F5597;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="07_5_f042" target="07_6_b8c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="07_12_ed74" value="5. 写入 access_token 映射" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="07_6_b8c3" target="07_7_a27f">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="07_13_3577" value="access_token：短 Token • 长度短 • 平台可撤销 • 业务访问时必须携带 • 通过 introspection 校验" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="350" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="07_14_9060" value="identity_token：身份票据 • 用于识别当前用户 • 字段由 Claims 模板控制 • 不默认下发敏感字段" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="350" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="07_15_9d91" value="返回" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F5597;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="07_6_b8c3" target="07_13_3577">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="07_16_495c" value="返回" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="07_6_b8c3" target="07_14_9060">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="07_17_9079" value="第三方应用自己的服务 只允许持有 access_token 的请求访问" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="555" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="07_18_1bcf" value="Claims 模板 控制输出：工号 / 邮箱 / 用户名 / 组织等" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF7E6;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="555" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="07_19_7ede" value="业务访问校验" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7E22CE;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="07_13_3577" target="07_17_9079">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="07_20_3c55" value="身份字段输出" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="07_14_9060" target="07_18_1bcf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="07_21_db8c" value="汇报口径：一个 token 不再硬塞所有信息。访问用短 token，用户信息用身份票据或 userinfo，撤销和字段控制都留在平台。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#D1D5DB;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="680" width="990" height="44" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="01 总览：统一安全出入口" id="DIzbscrHlzuaApEdIGgP">
    <mxGraphModel dx="1822" dy="977" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontColor=#0F172A;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;" value="&lt;b&gt;第三方授权代理：统一安全出入口&lt;/b&gt;" vertex="1">
