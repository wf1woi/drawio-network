            <mxPoint x="190" y="735" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n78" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=middle;spacing=10;" value="关键原则：前置检查不通过，请求不会碰到 ERP / e快宝；日志只存元数据，不保存密码、Cookie、Token、请求体。" vertex="1">
          <mxGeometry height="46" width="1280" x="60" y="810" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
