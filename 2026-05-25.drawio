        <mxCell id="n5" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontColor=#0F172A;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=2;" value="&lt;b&gt;XGD AI 平台｜第三方授权代理&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="380" x="488" y="120" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontColor=#0F172A;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=2;" value="&lt;b&gt;外部服务&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="220" x="1060" y="120" as="geometry" />
