        <mxCell id="n61" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#64748B;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;" value="所有检查都发生在请求到达外部服务之前；任一环节失败，平台直接拒绝。" vertex="1">
