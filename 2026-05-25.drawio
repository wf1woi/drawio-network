            <mxPoint x="510" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n76" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontSize=14;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;" value="6. 写审计日志&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;记录谁、何时、调了哪个接口、结果；不记录密钥和请求体&lt;/span&gt;" vertex="1">
          <mxGeometry height="82" width="220" x="400" y="620" as="geometry" />
        </mxCell>
        <mxCell id="e77" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;fontSize=12;fontColor=#374151;endArrow=block;endFill=1;" value="7. 返回标准化结果">
          <mxGeometry relative="1" as="geometry">
