        <mxCell id="n58" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=middle;spacing=10;" value="汇报口径：不是多做一个“转发接口”，而是把密码管理、接口权限、用户身份和审计记录集中到了平台。" vertex="1">
          <mxGeometry height="46" width="1280" x="60" y="810" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="03 时序图：应用调用外部服务" id="0ELVYc7pbPKnmlrsh5Nt">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
