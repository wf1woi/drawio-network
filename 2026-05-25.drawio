  <diagram id="e6da89604ba94d31ae9c9a1745a48e97" name="05 四道安全防线">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="05_3_cd5e" value="四道安全防线：任何一道不过，都不会访问外部系统" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#111827;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="05_4_139d" value="&lt;font style=&quot;font-size:34px&quot;&gt;&lt;b&gt;01&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;通行证检查&lt;/b&gt;&lt;br&gt;&lt;br&gt;平台 API Token 是否有效 是否在有效期内" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=16;fontColor=#111827;fontStyle=0;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="75" y="145" width="220" height="270" as="geometry" />
        </mxCell>
        <mxCell id="05_5_abdc" value="&lt;font style=&quot;font-size:34px&quot;&gt;&lt;b&gt;02&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;接口权限检查&lt;/b&gt;&lt;br&gt;&lt;br&gt;这个应用能不能调 这个服务、这个接口" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=16;fontColor=#111827;fontStyle=0;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="145" width="220" height="270" as="geometry" />
        </mxCell>
        <mxCell id="05_6_c22c" value="&lt;font style=&quot;font-size:34px&quot;&gt;&lt;b&gt;03&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;目标与身份检查&lt;/b&gt;&lt;br&gt;&lt;br&gt;地址白名单、路由状态 用户绑定、字段映射" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF7E6;strokeColor=#D97706;strokeWidth=1.5;fontSize=16;fontColor=#111827;fontStyle=0;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="625" y="145" width="220" height="270" as="geometry" />
        </mxCell>
        <mxCell id="05_7_0ee5" value="&lt;font style=&quot;font-size:34px&quot;&gt;&lt;b&gt;04&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;审计留痕&lt;/b&gt;&lt;br&gt;&lt;br&gt;记录调用结果 不记录密钥、Token、请求体" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=1.5;fontSize=16;fontColor=#111827;fontStyle=0;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="145" width="220" height="270" as="geometry" />
        </mxCell>
        <mxCell id="05_8_1abf" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="05_4_139d" target="05_5_abdc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="05_9_34b3" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="05_5_abdc" target="05_6_c22c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="05_10_48e3" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="05_6_c22c" target="05_7_0ee5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="05_11_0308" value="安全红线：权限、绑定、白名单、路由状态任一失败，请求在接触上游前就被拒绝，并写入审计。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDE2E2;strokeColor=#C62828;strokeWidth=1.5;fontSize=18;fontColor=#111827;fontStyle=1;spacing=10;align=center;" vertex="1" parent="1">
