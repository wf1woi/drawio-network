        </mxCell>
        <mxCell id="e74" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontSize=12;fontColor=#374151;endArrow=block;endFill=1;" value="4. 全部通过：取密钥并转发真实请求">
          <mxGeometry relative="1" as="geometry">
