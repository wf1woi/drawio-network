    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="03_3_a67b" value="管理员配置外部服务：从注册到可调用" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#111827;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="03_4_3709" value="&lt;b&gt;1. 注册服务&lt;/b&gt;&lt;br&gt;&lt;br&gt;名称 / 地址 / 标识符" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="150" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="03_5_f4f3" value="&lt;b&gt;2. 选择认证方式&lt;/b&gt;&lt;br&gt;&lt;br&gt;账号密码 / AppSecret / Cookie" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="335" y="150" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="03_6_791a" value="&lt;b&gt;3. 配置密钥&lt;/b&gt;&lt;br&gt;&lt;br&gt;加密保存，仅管理员可维护" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="615" y="150" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="03_7_1fd3" value="&lt;b&gt;4. 导入接口文档&lt;/b&gt;&lt;br&gt;&lt;br&gt;OpenAPI / Swagger" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF7E6;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="895" y="150" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="03_8_624c" value="&lt;b&gt;5. 预览接口列表&lt;/b&gt;&lt;br&gt;&lt;br&gt;接受 / 忽略 / 手动补全" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF7E6;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="370" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="03_9_b2d9" value="&lt;b&gt;6. 发布代理路由&lt;/b&gt;&lt;br&gt;&lt;br&gt;生成可调用地址" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="335" y="370" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="03_10_22f4" value="&lt;b&gt;7. 分配权限&lt;/b&gt;&lt;br&gt;&lt;br&gt;按角色 / 应用 / 接口" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="615" y="370" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="03_11_6444" value="&lt;b&gt;8. 应用调用&lt;/b&gt;&lt;br&gt;&lt;br&gt;只用平台 Token" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="895" y="370" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="03_12_5485" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="03_4_3709" target="03_5_f4f3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="03_13_cc6a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="03_5_f4f3" target="03_6_791a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="03_14_505d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="03_6_791a" target="03_7_1fd3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="03_15_d348" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1055" y="205" as="sourcePoint" />
            <mxPoint x="1055" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="03_16_01eb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="03_8_624c" target="03_9_b2d9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="03_17_17fa" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="03_9_b2d9" target="03_10_22f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="03_18_4a33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="03_10_22f4" target="03_11_6444">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="03_19_2aa5" value="汇报口径：管理员只需要把“外部服务、接口、权限、密钥”配置一次，后面的业务应用就不用重复维护第三方账号密码。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#D1D5DB;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="75" y="620" width="1030" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
