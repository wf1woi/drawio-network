  <diagram name="四种代理方式实现逻辑" id="GjtVVlYgSTEpSK8E4n5O">
    <mxGraphModel dx="2061" dy="977" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=28;fontStyle=1;fontColor=#0f172a;" value="四种代理方式：配置项与运行逻辑" vertex="1">
          <mxGeometry height="40" width="760" x="40" y="24" as="geometry" />
        </mxCell>
        <mxCell id="p2_sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#475569;spacing=4;" value="每种方式都复用同一条主链路：A Token鉴权 → 服务/API路由 → 权限校验 → 请求构造 → 第三方调用 → 日志审计。差异只在“是否注入用户字段、是否前置认证、前置认证是否按用户隔离”。" vertex="1">
          <mxGeometry height="38" width="1100" x="42" y="66" as="geometry" />
        </mxCell>
        <mxCell id="lane1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.4;verticalAlign=top;spacingTop=12;fontSize=16;fontStyle=1;strokeColor=#2563eb;fillColor=#eff6ff;fontColor=#1e3a8a;" value="&lt;b&gt;方式一：固定接口直连&lt;/b&gt;" vertex="1">
          <mxGeometry height="740" width="330" x="45" y="130" as="geometry" />
        </mxCell>
        <mxCell id="lane2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.4;verticalAlign=top;spacingTop=12;fontSize=16;fontStyle=1;strokeColor=#16a34a;fillColor=#f0fdf4;fontColor=#14532d;" value="&lt;b&gt;方式二：A用户字段映射&lt;/b&gt;" vertex="1">
          <mxGeometry height="740" width="330" x="405" y="130" as="geometry" />
        </mxCell>
        <mxCell id="lane3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.4;verticalAlign=top;spacingTop=12;fontSize=16;fontStyle=1;strokeColor=#ea580c;fillColor=#fff7ed;fontColor=#7c2d12;" value="&lt;b&gt;方式三：服务级前置Token&lt;/b&gt;" vertex="1">
          <mxGeometry height="740" width="330" x="765" y="130" as="geometry" />
        </mxCell>
        <mxCell id="lane4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.4;verticalAlign=top;spacingTop=12;fontSize=16;fontStyle=1;strokeColor=#7c3aed;fillColor=#f5f3ff;fontColor=#4c1d95;" value="&lt;b&gt;方式四：用户级前置Token/Cookie&lt;/b&gt;" vertex="1">
          <mxGeometry height="740" width="330" x="1125" y="130" as="geometry" />
        </mxCell>
        <mxCell id="m1s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#3b82f6;fillColor=#dbeafe;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;1. 管理员建代理服务&lt;/b&gt;&lt;br&gt;serviceCode=dw，代理后缀=/dw" vertex="1">
          <mxGeometry height="70" width="280" x="70" y="185" as="geometry" />
        </mxCell>
        <mxCell id="m1s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#94a3b8;fillColor=#ffffff;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;2. 手动添加API&lt;/b&gt;&lt;br&gt;配置真实URL、Method、Header、Body；可测试调用" vertex="1">
          <mxGeometry height="70" width="280" x="70" y="280" as="geometry" />
        </mxCell>
        <mxCell id="m1s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#94a3b8;fillColor=#ffffff;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;3. 分配权限&lt;/b&gt;&lt;br&gt;服务级权限 + API级权限统一走权限模块" vertex="1">
          <mxGeometry height="70" width="280" x="70" y="375" as="geometry" />
        </mxCell>
        <mxCell id="m1s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#3b82f6;fillColor=#dbeafe;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;4. 用户调用A代理地址&lt;/b&gt;&lt;br&gt;/api/proxy/dw/api/zaobao 或随机API后缀" vertex="1">
          <mxGeometry height="70" width="280" x="70" y="470" as="geometry" />
        </mxCell>
        <mxCell id="m1s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#3b82f6;fillColor=#dbeafe;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;5. A直连第三方&lt;/b&gt;&lt;br&gt;鉴权、路由、权限通过后，透传或包装D1响应" vertex="1">
          <mxGeometry height="70" width="280" x="70" y="565" as="geometry" />
        </mxCell>
        <mxCell id="m2s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#22c55e;fillColor=#dcfce7;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;1. 配置用户字段映射&lt;/b&gt;&lt;br&gt;例：body.userInfo ← A用户.jobNo / username / email" vertex="1">
          <mxGeometry height="70" width="280" x="430" y="185" as="geometry" />
        </mxCell>
        <mxCell id="m2s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#94a3b8;fillColor=#ffffff;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;2. 用户只传业务参数&lt;/b&gt;&lt;br&gt;meetingId、startTime、endTime、placeName" vertex="1">
          <mxGeometry height="70" width="280" x="430" y="280" as="geometry" />
        </mxCell>
        <mxCell id="m2s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#94a3b8;fillColor=#ffffff;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;3. A解析API Token&lt;/b&gt;&lt;br&gt;拿到当前调用人的A系统用户信息" vertex="1">
          <mxGeometry height="70" width="280" x="430" y="375" as="geometry" />
        </mxCell>
        <mxCell id="m2s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#22c55e;fillColor=#dcfce7;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;4. 请求构造器自动补参&lt;/b&gt;&lt;br&gt;把 userInfo=1010600 写入原始请求体" vertex="1">
          <mxGeometry height="70" width="280" x="430" y="470" as="geometry" />
        </mxCell>
        <mxCell id="m2s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#22c55e;fillColor=#dcfce7;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;5. 调用D2业务接口&lt;/b&gt;&lt;br&gt;用户无需知道、无需填写受控身份参数" vertex="1">
          <mxGeometry height="70" width="280" x="430" y="565" as="geometry" />
        </mxCell>
        <mxCell id="m3s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#f97316;fillColor=#ffedd5;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;1. 配置服务级前置认证&lt;/b&gt;&lt;br&gt;tokenUrl、appid/appsecret、提交格式、token解析节点" vertex="1">
          <mxGeometry height="70" width="280" x="790" y="185" as="geometry" />
        </mxCell>
        <mxCell id="m3s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#94a3b8;fillColor=#ffffff;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;2. 配置Token放置位置&lt;/b&gt;&lt;br&gt;query 参数 / Bearer / Basic / 自定义Header" vertex="1">
          <mxGeometry height="70" width="280" x="790" y="280" as="geometry" />
        </mxCell>
        <mxCell id="m3s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#94a3b8;fillColor=#ffffff;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;3. A检查服务Token缓存&lt;/b&gt;&lt;br&gt;命中缓存则不重复获取；未配置缓存则每次获取" vertex="1">
          <mxGeometry height="70" width="280" x="790" y="375" as="geometry" />
        </mxCell>
        <mxCell id="m3s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#f97316;fillColor=#ffedd5;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;4. 自动前置调用&lt;/b&gt;&lt;br&gt;获取 data.accessToken 并写入正式请求" vertex="1">
          <mxGeometry height="70" width="280" x="790" y="470" as="geometry" />
        </mxCell>
        <mxCell id="m3s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#f97316;fillColor=#ffedd5;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;5. Token失效重试一次&lt;/b&gt;&lt;br&gt;刷新token后重新调用实际接口" vertex="1">
          <mxGeometry height="70" width="280" x="790" y="565" as="geometry" />
        </mxCell>
        <mxCell id="m4s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#8b5cf6;fillColor=#ede9fe;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;1. 管理员配置绑定模板&lt;/b&gt;&lt;br&gt;预留账号密码 / appid / appsecret / 登录URL / Cookie规则" vertex="1">
          <mxGeometry height="70" width="280" x="1150" y="185" as="geometry" />
        </mxCell>
        <mxCell id="m4s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#94a3b8;fillColor=#ffffff;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;2. 用户进入A进行绑定&lt;/b&gt;&lt;br&gt;每个用户填写自己的第三方账号或密钥" vertex="1">
          <mxGeometry height="70" width="280" x="1150" y="280" as="geometry" />
        </mxCell>
        <mxCell id="m4s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#94a3b8;fillColor=#ffffff;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;3. A按用户维度前置认证&lt;/b&gt;&lt;br&gt;获取该用户专属 token 或 cookie" vertex="1">
          <mxGeometry height="70" width="280" x="1150" y="375" as="geometry" />
        </mxCell>
        <mxCell id="m4s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#8b5cf6;fillColor=#ede9fe;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;4. 用户级缓存隔离&lt;/b&gt;&lt;br&gt;缓存Key包含 serviceCode + userId + authConfigId" vertex="1">
          <mxGeometry height="70" width="280" x="1150" y="470" as="geometry" />
        </mxCell>
        <mxCell id="m4s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#8b5cf6;fillColor=#ede9fe;strokeWidth=1.1;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;5. 可叠加用户字段映射&lt;/b&gt;&lt;br&gt;同时支持方式二：业务参数里注入A用户字段" vertex="1">
          <mxGeometry height="70" width="280" x="1150" y="565" as="geometry" />
        </mxCell>
