        <mxCell id="e70" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;fontSize=12;fontColor=#374151;endArrow=block;endFill=1;" value="1. 调用 /proxy/erp/billno，携带平台 Token">
