        <mxCell id="n3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#64748B;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;" value="内部应用只拿平台 Token；外部服务的密钥、权限、转发、审计都交给 XGD 平台统一处理。" vertex="1">
