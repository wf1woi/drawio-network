  <diagram id="a8e0d3d4b4b347c6840f683a968326b7" name="06 批量导入与密钥审批">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="06_3_b737" value="两个提效与控险流程：批量导入接口 + 密钥变更审批" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#111827;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="06_4_0350" value="A. OpenAPI / Swagger 批量导入" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#111827;fontStyle=1;spacing=0;" vertex="1" parent="1">
