        <mxCell id="n34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=middle;spacing=10;" value="汇报口径：它像一个“安全代办窗口”。小应用只找平台办事，平台负责确认身份、拿正确钥匙、调用外部系统、留下记录。" vertex="1">
          <mxGeometry height="46" width="1280" x="60" y="820" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
