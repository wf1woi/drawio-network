        <mxCell id="06_6_c75b" value="&lt;b&gt;自动解析&lt;/b&gt;&lt;br&gt;生成候选接口" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="155" width="165" height="85" as="geometry" />
        </mxCell>
        <mxCell id="06_7_0596" value="&lt;b&gt;预览确认&lt;/b&gt;&lt;br&gt;新增 / 变更 / 模糊" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF7E6;strokeColor=#D97706;strokeWidth=1.5;fontSize=13;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="495" y="155" width="165" height="85" as="geometry" />
        </mxCell>
        <mxCell id="06_8_17f9" value="&lt;b&gt;发布路由&lt;/b&gt;&lt;br&gt;生成代理接口" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=13;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="710" y="155" width="165" height="85" as="geometry" />
        </mxCell>
        <mxCell id="06_9_8ff4" value="&lt;b&gt;当天调用&lt;/b&gt;&lt;br&gt;应用可用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=13;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="925" y="155" width="165" height="85" as="geometry" />
        </mxCell>
        <mxCell id="06_10_8fc2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="06_5_06c5" target="06_6_c75b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="06_11_7281" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="06_6_c75b" target="06_7_0596">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="06_12_fe00" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="06_7_0596" target="06_8_17f9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="06_13_d05a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="06_8_17f9" target="06_9_8ff4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="06_14_51a4" value="价值：几十个接口不用手工一条条录入，管理员预览后再发布，避免错误配置直接上线。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#D1D5DB;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=0;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="270" width="1000" height="44" as="geometry" />
        </mxCell>
        <mxCell id="06_15_9093" value="B. 密钥变更审批" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#111827;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="370" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="06_16_ff31" value="服务负责人 提交新密钥" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EAF2FF;strokeColor=#2F5597;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="430" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="06_17_a703" value="待审批区 暂不生效" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF7E6;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="430" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="06_18_7a92" value="平台管理员 审批" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="430" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="06_19_c713" value="通过：替换旧密钥 开始生效" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="385" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="06_20_028b" value="拒绝：保留记录 不使用新密钥" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDE2E2;strokeColor=#C62828;strokeWidth=1.5;fontSize=14;fontColor=#111827;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="505" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="06_21_8605" value="提交" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F5597;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="06_16_ff31" target="06_17_a703">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="06_22_7522" value="查看" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="06_17_a703" target="06_18_7a92">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="06_23_8687" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="06_18_7a92" target="06_19_c713">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="06_24_0cb1" value="拒绝" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="06_18_7a92" target="06_20_028b">
