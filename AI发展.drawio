        <mxCell id="bWfFV29Gd1WzGgcMj802-28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#F8FAFC;strokeColor=#D0D5DD;fontSize=12;align=left;verticalAlign=top;spacing=12;" value="&lt;div style=&#39;font-family:Helvetica;&#39;&gt;&lt;div style=&#39;font-size:14px;font-weight:700;color:#111827;&#39;&gt;能力变化&lt;/div&gt;&lt;div style=&#39;font-size:12px;color:#475467;margin-top:8px;line-height:1.45;&#39;&gt;从“只能回答”演进到“能理解、能调用、能执行、能持续运行”&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="86" width="580" x="80" y="545" as="geometry" />
        </mxCell>
        <mxCell id="bWfFV29Gd1WzGgcMj802-29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#F8FAFC;strokeColor=#D0D5DD;fontSize=12;align=left;verticalAlign=top;spacing=12;" value="&lt;div style=&#39;font-family:Helvetica;&#39;&gt;&lt;div style=&#39;font-size:14px;font-weight:700;color:#111827;&#39;&gt;对开发者意味着什么&lt;/div&gt;&lt;div style=&#39;font-size:12px;color:#475467;margin-top:8px;line-height:1.45;&#39;&gt;开发门槛持续下降：从写提示词，到接 API，再到拖流程、自然语言生成代码、封装技能&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="86" width="580" x="700" y="545" as="geometry" />
        </mxCell>
        <mxCell id="bWfFV29Gd1WzGgcMj802-30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#F8FAFC;strokeColor=#D0D5DD;fontSize=12;align=left;verticalAlign=top;spacing=12;" value="&lt;div style=&quot;font-family:Helvetica;&quot;&gt;&lt;div style=&quot;font-size: 14px; font-weight: 700; color: rgb(17, 24, 39);&quot;&gt;对普通用户的启发&lt;/div&gt;&lt;div style=&quot;font-size: 12px; color: rgb(71, 84, 103); margin-top: 8px; line-height: 1.45;&quot;&gt;现在做小工具/小应用，不一定先学完所有编程；先学会“描述需求、拆步骤、验结果”更重要&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="86" width="580" x="1310" y="545" as="geometry" />
        </mxCell>
        <mxCell id="bWfFV29Gd1WzGgcMj802-31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFAEB;strokeColor=#F79009;fontSize=12;align=left;verticalAlign=top;spacing=12;" value="&lt;div style=&#39;font-family:Helvetica;font-size:12px;line-height:1.45;color:#344054;&#39;&gt;&lt;b&gt;建议讲法：&lt;/b&gt;&lt;br/&gt;1. 第 0 代：AI 会说，但不会做。&lt;br/&gt;2. 第 1~2 代：AI 开始会查、会调工具、会走流程。&lt;br/&gt;3. 第 3~4 代：AI 不只是聊天，而是开始像“数字员工”。&lt;br/&gt;4. 第 5 代：最终目标是形成感知—决策—执行闭环。&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="180" x="2120" y="40" as="geometry" />
        </mxCell>
