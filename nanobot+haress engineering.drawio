  <diagram name="选型与组合方式" id="gq9FDl3z7AGZRq02Ag5i">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2t1" value="OpenClaw 与各类 CLI 的选型与组合方式" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#111827;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="800" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2t2" value="不要把它们简单看成互相替代。先判断你要解决的是“本地编码效率问题”，还是“统一入口 / 渠道 / 平台编排问题”。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7280;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="1450" height="24" as="geometry" />
        </mxCell>
        <mxCell id="start" value="你要解决的问题是哪一层？" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="主要目标是否是&lt;br/&gt;本地代码仓库里的开发效率？" style="shape=rhombus;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="635" y="240" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="优先：Claude Code / Codex / Gemini CLI / OpenCode&lt;br/&gt;&lt;font style=&quot;font-size:13px;font-weight:normal;&quot;&gt;适合读仓库、改代码、跑测试、调 MCP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="240" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="是否需要消息渠道、移动端入口、统一会话、路由编排？" style="shape=rhombus;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="240" y="470" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="优先：OpenClaw&lt;br/&gt;&lt;font style=&quot;font-size:13px;font-weight:normal;&quot;&gt;适合统一入口、聊天渠道、路由、会话、插件、网关化&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="680" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="按具体场景选择&lt;br/&gt;&lt;font style=&quot;font-size:13px;font-weight:normal;&quot;&gt;若只是简单模型调用，不一定需要完整平台层&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="680" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="是否还需要&lt;br/&gt;强编码执行器？" style="shape=rhombus;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1180" y="520" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="OpenClaw 原生能力即可&lt;br/&gt;&lt;font style=&quot;font-size:13px;font-weight:normal;&quot;&gt;Tools / Skills / Plugins / Providers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="710" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="推荐组合：OpenClaw + ACP Agents + CLI&lt;br/&gt;&lt;font style=&quot;font-size:13px;font-weight:normal;&quot;&gt;OpenClaw 管入口 / 权限 / 会话；CLI 管改代码 / 跑命令&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1320" y="710" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="常见误区" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=1.2;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="170" width="120" height="36" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="把 OpenClaw 和各类 CLI 当成完全同层产品。&lt;br/&gt;实际更接近：平台层 vs 执行器层。" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="215" width="220" height="95" as="geometry" />
