        <mxCell id="n3" value="最稳的组合思路" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=1.2;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
